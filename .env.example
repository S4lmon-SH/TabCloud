# pnpm dev/start read the root .env; Compose reads it when present.
HOST=0.0.0.0
PORT=3001
# Exact origins, no trailing slash; comma-separated when needed behind a proxy.
PUBLIC_ORIGIN=http://localhost:3001
ROOM_TTL_MS=3600000
IDLE_ROOM_TTL_MS=600000
HEARTBEAT_TIMEOUT_MS=20000
LEASE_MS=15000
MAX_ATTEMPT_MS=120000
MAX_JOB_MS=600000
SWEEP_INTERVAL_MS=1000
MAX_RETRIES=5
MAX_ROOMS=32
MAX_PARTICIPANTS=24
MAX_PARTICIPANT_HISTORY=64
MAX_JOB_BYTES=25165824
MAX_TOTAL_RESULT_BYTES=134217728
MAX_CONNECTIONS=256
MAX_MESSAGES_PER_SECOND=250
ROOM_CREATES_PER_MINUTE=10
MAX_BUFFERED_BYTES=2097152
# Optional absolute path; defaults to the installed ffmpeg-static executable.
# FFMPEG_PATH=C:\tools\ffmpeg\bin\ffmpeg.exe
# Set only when hosting the frontend separately, e.g. on Vercel.
# VITE_API_ORIGIN=https://your-tabcloud-server.onrender.com
